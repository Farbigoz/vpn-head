# --- Локальное окружение (скопируйте в .env и заполните) ---

# Файл с паролем Ansible Vault. Сам файл НЕ коммитить:
#   echo 'ваш-пароль' > ~/.vpn-head-vault-pass && chmod 600 ~/.vpn-head-vault-pass
ANSIBLE_VAULT_PASSWORD_FILE=~/.vpn-head-vault-pass

# Какой инвентарь использовать по умолчанию (каталог внутри ansible/inventories/)
VPN_HEAD_INVENTORY=example
