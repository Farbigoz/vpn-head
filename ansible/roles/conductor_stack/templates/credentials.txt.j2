# ══ vpn-head: доступы дирижёра ══
# Сгенерировано Ansible ({{ ansible_date_time.date }}). Права файла: 600.
# Не пересылайте этот файл. Основное хранилище секретов — Ansible Vault.

Semaphore (Web UI): http://127.0.0.1:{{ semaphore_port }}
  логин:  {{ vault_semaphore_admin_user | default('admin') }}
  пароль: {{ semaphore_admin_password }}

Uptime Kuma: http://127.0.0.1:{{ kuma_port }}
  (аккаунт создаётся мастером при первом открытии)

3x-ui master: порт {{ xui_master_port }}, путь /{{ xui_panel_path }}/
  креды: vault_xui_master_user / vault_xui_master_password (в Vault)

Доступ с локального ПК (SSH-туннель):
  ssh -L {{ semaphore_port }}:127.0.0.1:{{ semaphore_port }} -L {{ kuma_port }}:127.0.0.1:{{ kuma_port }} {{ ansible_user }}@{{ ansible_host }}
