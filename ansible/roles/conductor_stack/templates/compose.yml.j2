# Управляется Ansible (vpn-head, роль conductor_stack). Не редактировать вручную.
name: vpn-head

services:
  semaphore:
    image: semaphoreui/semaphore:v{{ semaphore_version }}
    restart: unless-stopped
    ports:
      # Web UI слушает localhost — доступ через SSH-туннель
      # (см. docs/admin-ux.md). Наружу открывает UFW только если
      # задан conductor_ui_allowed_from.
      - "127.0.0.1:{{ semaphore_port }}:3000"
    environment:
      SEMAPHORE_DB_DIALECT: bolt
      SEMAPHORE_ADMIN: "{{ vault_semaphore_admin_user | default('admin') }}"
      SEMAPHORE_ADMIN_PASSWORD: "{{ semaphore_admin_password }}"
      SEMAPHORE_ADMIN_NAME: "vpn-head admin"
      SEMAPHORE_ADMIN_EMAIL: "{{ semaphore_admin_email | default('admin@localhost') }}"
      SEMAPHORE_WEB_ROOT: "/"
      # Ключи шифрования — фиксированные (иначе после пересоздания
      # контейнера ключи в БД не расшифровываются)
      SEMAPHORE_COOKIE_HASH: "{{ semaphore_cookie_hash }}"
      SEMAPHORE_COOKIE_ENCRYPTION: "{{ semaphore_cookie_encryption }}"
      SEMAPHORE_ACCESS_KEY_ENCRYPTION: "{{ semaphore_access_key_encryption }}"
      # Репозиторий /repo смонтирован с хоста — git ругается на владельца
      GIT_CONFIG_COUNT: "1"
      GIT_CONFIG_KEY_0: "safe.directory"
      GIT_CONFIG_VALUE_0: "*"
    volumes:
      - semaphore-data:/var/lib/semaphore
      # Репозиторий vpn-head — шаблоны Ansible внутри Web UI
      - /opt/vpn-head:/repo:ro

  uptime-kuma:
    image: louislam/uptime-kuma:{{ kuma_version }}
    restart: unless-stopped
    ports:
      - "127.0.0.1:{{ kuma_port }}:3001"
    volumes:
      - kuma-data:/app/data

volumes:
  semaphore-data:
  kuma-data:
